# PostgreSQL connection string
# Local example: postgresql://postgres:your_password@localhost:5432/learn_accounting?schema=public
# Render example: Use Render's Internal Database URL when the Web Service and PostgreSQL are in the same region.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/learn_accounting?schema=public"

# Long random secret used to sign/hash session tokens (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Runtime environment: development | production | test
NODE_ENV="development"

# Port the Express server binds to on 0.0.0.0 (Render automatically sets PORT in production)
PORT="4000"

# Optional (Development ONLY): Set to "true" to create a local demo student when running prisma:seed.
# NEVER enable this in production.
SEED_DEMO_USER="false"
